@model IEnumerable<JobHunter.Models.Job>

@{
    ViewData["Title"] = "My Applied Jobs";
 
    string GetTimeAgo(DateTime postedDate)
    {
        var diff = DateTime.Now - postedDate;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 30) return $"{(int)diff.TotalDays}d ago";
        return postedDate.ToString("MMM dd, yyyy");
    }
}

<style>
   
    .jobs-header {
        background: linear-gradient(135deg, #5f9ea0 0%, #2c3e50 100%);
        padding: 50px 20px;
        border-radius: 20px;
        margin-bottom: 40px;
        color: white;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    }

    .header-content h1 {
        font-size: 3rem;
        font-weight: 800;
        margin: 0;
    }

    .header-content p {
        font-size: 1.2rem;
        opacity: 0.9;
        margin-top: 10px;
    }

 
    .jobs-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 25px;
        padding: 10px;
    }

    
    .job-box {
        background: white;
        border-radius: 15px;
        border: 1px solid #eee;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: transform 0.3s ease;
        position: relative;
    }

        .job-box:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            border-color: cadetblue;
        }

    .image-wrapper {
        height: 200px;
        position: relative;
    }

    .job-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
 
    .time-badge {
        position: absolute;
        bottom: 10px;
        right: 10px;
        background: rgba(0, 0, 0, 0.65);
        color: white;
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 0.8rem;
        backdrop-filter: blur(5px);
    }

    .job-content {
        padding: 20px;
    }

    .job-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 12px;
    }

  
    .job-requirements {
        font-size: 0.95rem;
        color: #666;
        line-height: 1.6;
        white-space: pre-wrap;
    }
</style>

<div class="jobs-header">
    <div class="header-content">
        <h1>My Applied Jobs</h1>
        <p>Jobs you have applied for</p>
    </div>
</div>

<div class="jobs-container">
    @foreach (var item in Model)
    {
        <div class="job-box">
            <div class="image-wrapper">
                <img src="@(string.IsNullOrEmpty(item.ImagePath) ? "/images/default-job.png" : item.ImagePath)" class="job-image" />
                <div class="time-badge">
                    <i class="far fa-clock"></i> @GetTimeAgo(item.PostedDate)
                </div>
            </div>

            <div class="job-content">
                <div class="job-title">@item.JobTitle</div>

                <div class="job-requirements">
                    <strong>Requirements:</strong><br />
                    @item.Requirements
                </div>
            </div>
        </div>
    }
</div>