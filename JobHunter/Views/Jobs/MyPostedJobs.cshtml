@model IEnumerable<JobHunter.Models.Job>

@{
    ViewData["Title"] = "My Posted Jobs";

    string GetTimeAgo(DateTime postedDate)
    {
        var diff = DateTime.Now - postedDate;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 30) return $"{(int)diff.TotalDays}d ago";
        return postedDate.ToString("MMM dd, yyyy");
    }
}

<style>
 
    .jobs-header {
        background: linear-gradient(135deg, #5f9ea0 0%, #2c3e50 100%);
        padding: 50px 20px;
        border-radius: 20px;
        margin-bottom: 40px;
        color: white;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    }

    .header-content h1 {
        font-size: 3rem;
        font-weight: 800;
        margin: 0;
    }

    .header-content p {
        font-size: 1.2rem;
        opacity: 0.9;
        margin-top: 10px;
    }
 
    .action-bar {
        margin-bottom: 30px;
        padding: 0 10px;
    }

    .btn-create {
        background-color: #2c3e50;
        color: white !important;
        padding: 12px 25px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }

  
    .jobs-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 25px;
        padding: 10px;
    }
 
    .job-box {
        background: white;
        border-radius: 15px;
        border: 1px solid #eee;
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
        transition: transform 0.3s ease;
        position: relative;
    }

        .job-box:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            border-color: cadetblue;
        }

    .image-wrapper {
        height: 200px;
        position: relative;
    }

    .job-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .time-badge {
        position: absolute;
        bottom: 10px;
        right: 10px;
        background: rgba(0, 0, 0, 0.65);
        color: white;
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 0.8rem;
        backdrop-filter: blur(5px);
    }

    .job-content {
        padding: 20px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .job-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 12px;
    }

    .job-requirements {
        font-size: 0.95rem;
        color: #666;
        margin-bottom: 25px;
        line-height: 1.6;
        white-space: pre-wrap;
        flex-grow: 1;
    }

   
    .action-buttons-container {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: auto;
        padding-top: 15px;
        border-top: 1px solid #f0f0f0;
    }

    .edit-delete-row {
        display: flex;
        gap: 10px;
    }

    .btn-action-base {
        text-align: center;
        padding: 10px;
        border-radius: 10px;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 700;
        transition: all 0.3s;
    }

   
    .btn-edit-item {
        flex: 1;
        background-color: white;
        color: #2c3e50 !important;
        border: 1px solid #ddd;
    }

    .btn-delete-item {
        flex: 1;
        background-color: #fff1f0;
        color: #e74c3c !important;
        border: 1px solid #ffa39e;
    }
 
    .btn-view-apps-item {
        width: 100%;
        background-color: cadetblue;
        color: white !important;
    }

        .btn-view-apps-item:hover {
            background-color: #4a7c7e;
        }
</style>

<div class="jobs-header">
    <div class="header-content">
        <h1>My Posted Jobs</h1>
        <p>Review and manage your active job listings</p>
    </div>
</div>

<div class="action-bar">
    <a asp-action="Create" class="btn-create">Hire / Post New Job</a>
</div>

<div class="jobs-container">
    @foreach (var item in Model)
    {
        <div class="job-box">
            <div class="image-wrapper">
                <img src="@(string.IsNullOrEmpty(item.ImagePath) ? "/images/default-job.png" : item.ImagePath)" class="job-image" />
                <div class="time-badge">
                    <i class="far fa-clock"></i> @GetTimeAgo(item.PostedDate)
                </div>
            </div>

            <div class="job-content">
                <div class="job-title">@item.JobTitle</div>

                <div class="job-requirements">
                    <strong>Requirements:</strong><br />
                    @item.Requirements
                </div>

                <div class="action-buttons-container">
                    <div class="edit-delete-row">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action-base btn-edit-item">
                            Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action-base btn-delete-item">
                            Delete
                        </a>
                    </div>

                    <a asp-action="ViewApplications" asp-route-id="@item.Id" class="btn-action-base btn-view-apps-item">
                        View Applications
                    </a>
                </div>
            </div>
        </div>
    }
</div>