@model IEnumerable<JobHunter.Models.Job>

@{
    ViewData["Title"] = "All Jobs";

    string GetTimeAgo(DateTime postedDate)
    {
        var diff = DateTime.Now - postedDate;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 30) return $"{(int)diff.TotalDays}d ago";
        return postedDate.ToString("MMM dd, yyyy");
    }
}

<style>
 
    .pagination {
        margin-top: 30px;
        justify-content: center;
        gap: 5px;
    }
     
    .page-link {
        color: cadetblue; 
        border: 1px solid #dee2e6;
        border-radius: 8px !important;  
        padding: 8px 16px;
        transition: all 0.3s ease;
    }

        .page-link:hover {
            background-color: #f8f9fa;
            color: #4a7c7d;  
            border-color: cadetblue;
        }
 
    .page-item.active .page-link {
        background-color: cadetblue !important;  
        border-color: cadetblue !important;
        color: white !important;  
        box-shadow: 0 4px 10px rgba(95, 158, 160, 0.3);
    }

    .page-link:focus {
        box-shadow: 0 0 0 0.2rem rgba(95, 158, 160, 0.25);
    }
 

    .jobs-header {
        background: linear-gradient(135deg, #5f9ea0 0%, #2c3e50 100%);
        padding: 60px 20px;
        border-radius: 20px;
        margin-bottom: 40px;
        color: white;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        position: relative;
    }

    .header-content h1 {
        font-size: 3rem;
        font-weight: 800;
        margin: 0;
        letter-spacing: -1px;
    }

    .header-content p {
        font-size: 1.2rem;
        opacity: 0.9;
        margin-top: 10px;
    }

    .action-bar {
        display: flex;
        justify-content: flex-start;
        margin-bottom: 30px;
        padding: 0 10px;
    }

    .btn-applications {
        background-color: #2c3e50;
        color: white !important;
        padding: 12px 25px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .jobs-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 25px;
        padding: 10px;
    }

    .job-box {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid #eee;
        position: relative;
    }

        .job-box:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            border-color: cadetblue;
        }

    .image-wrapper {
        position: relative;
        height: 200px;
        overflow: hidden;
    }

    .job-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .time-badge {
        position: absolute;
        bottom: 10px;
        right: 10px;
        background: rgba(0, 0, 0, 0.65);
        color: white;
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 0.8rem;
        backdrop-filter: blur(5px);
        font-weight: 500;
    }

    .job-content {
        padding: 20px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .job-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 12px;
    }

    .job-requirements {
        font-size: 0.95rem;
        color: #666;
        margin-bottom: 20px;
        white-space: pre-wrap;
    }

    .job-button-container {
        margin-top: auto;
    }

    .btn-apply, .btn-view-apps {
        display: block;
        width: 100%;
        background-color: cadetblue;
        color: white !important;
        text-align: center;
        padding: 12px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 700;
        transition: background 0.3s;
    }

    .owner-actions-container {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .edit-delete-row {
        display: flex;
        gap: 10px;
    }

    .btn-action-small {
        flex: 1;
        padding: 10px;
        border-radius: 10px;
        font-weight: 700;
        text-decoration: none;
        text-align: center;
        font-size: 0.9rem;
        transition: all 0.3s;
    }

    .btn-edit-white {
        background-color: white;
        color: #2c3e50 !important;
        border: 1px solid #ddd;
    }

    .btn-delete-light {
        background-color: #fff1f0;
        color: #e74c3c !important;
        border: 1px solid #ffa39e;
    }

    .applied-status-badge {
        text-align: center;
        padding: 12px;
        border-radius: 10px;
        font-weight: 700;
        border: 2px solid cadetblue;
        color: cadetblue;
        background-color: rgba(95, 158, 160, 0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-transform: uppercase;
        font-size: 0.85rem;
    }
</style>

<div class="jobs-header">
    <div class="header-content">
        <h1>Welcome to JobHunter</h1>
        <p>Your gateway to the next big opportunity</p>
    </div>
</div>

<div class="action-bar">
    <a asp-action="MyApplications" class="btn-applications">
        <i class="fas fa-briefcase"></i> My Applications
    </a>
</div>

<div class="jobs-container">
    @foreach (var item in Model)
    {
        <div class="job-box">
            <div class="image-wrapper">
                @if (!string.IsNullOrEmpty(item.ImagePath))
                {
                    <img src="@item.ImagePath" alt="Job Image" class="job-image" />
                }
                else
                {
                    <img src="/images/default-job.png" alt="No Image" class="job-image" />
                }
                <div class="time-badge">
                    <i class="far fa-clock"></i> @GetTimeAgo(item.PostedDate)
                </div>
            </div>

            <div class="job-content">
                <div class="job-title">@item.JobTitle</div>

                <div class="job-requirements">
                    <strong>Requirements:</strong><br />
                    @item.Requirements
                </div>

                <div class="job-button-container">
                    @{
                        var appliedIds = ViewBag.AppliedJobIds as List<int> ?? new List<int>();
                        var currentUserId = ViewBag.CurrentUserId as string;
                    }

                    @if (User.Identity.IsAuthenticated && item.CreatedById == currentUserId)
                    {
                        <div class="owner-actions-container">
                            <div class="edit-delete-row">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action-small btn-edit-white">
                                    Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action-small btn-delete-light">
                                    Delete
                                </a>
                            </div>
                            <a asp-action="ViewApplications" asp-route-id="@item.Id" class="btn-view-apps">
                                View Applications
                            </a>
                        </div>
                    }
                    else
                    {
                        @if (appliedIds.Contains(item.Id))
                        {
                            <div class="applied-status-badge">
                                <i class="fas fa-check-circle"></i> Already Applied
                            </div>
                        }
                        else
                        {
                            <a asp-action="Apply" asp-route-id="@item.Id" asp-controller="Jobs" class="btn-apply">
                                Apply Now
                            </a>
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>
<nav aria-label="Page navigation">
    <ul class="pagination">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link" href="@Url.Action("AllJobs", new { page = i })">@i</a>
            </li>
        }
    </ul>
</nav>