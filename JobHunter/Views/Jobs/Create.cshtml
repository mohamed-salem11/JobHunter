@model JobHunter.Models.Job

@{
    ViewData["Title"] = "Post a New Job";
}

<style>
    .create-page-container {
        background-color: #f8f9fa;
        padding: 50px 0;
        min-height: 90vh;
    }

    .create-card {
        background: white;
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .card-header-gradient {
        background: linear-gradient(135deg, #5f9ea0 0%, #2c3e50 100%);
        color: white;
        padding: 30px;
        text-align: center;
        border: none;
    }

    .form-section {
        padding: 40px;
    }

    .form-label {
        font-weight: 700;
        color: #2d3748;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.95rem;
    }

    .form-control {
        border-radius: 12px;
        padding: 14px 18px;
        border: 1px solid #e2e8f0;
        background-color: #f8fafc;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            background-color: white;
            border-color: cadetblue !important;
            box-shadow: 0 0 0 4px rgba(95, 158, 160, 0.1) !important;
        }

     
    .file-upload-wrapper {
        position: relative;
        border: 2px dashed #cbd5e0;
        border-radius: 15px;
        padding: 30px;
        text-align: center;
        background-color: #f8fafc;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .file-upload-wrapper:hover {
            border-color: cadetblue;
            background-color: #f0f7f7;
        }

    .upload-icon {
        font-size: 2.5rem;
        color: cadetblue;
        margin-bottom: 10px;
    }

    .preview-img-container {
        display: none;
        margin-top: 15px;
    }

        .preview-img-container img {
            max-width: 100%;
            height: 150px;
            border-radius: 10px;
            object-fit: cover;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

    .btn-submit {
        background-color: cadetblue;
        color: white;
        border: none;
        padding: 15px 30px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1.1rem;
        width: 100%;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(95, 158, 160, 0.3);
    }

        .btn-submit:hover {
            background-color: #4a7c7e;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(95, 158, 160, 0.4);
        }

    .btn-back-link {
        display: block;
        text-align: center;
        margin-top: 20px;
        color: #64748b;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.3s ease;
    }

        .btn-back-link:hover {
            color: cadetblue;
        }

    .helper-text {
        font-size: 0.8rem;
        color: #94a3b8;
        margin-top: 5px;
    }
</style>

<div class="create-page-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                <div class="create-card">
                    <div class="card-header-gradient">
                        <h2 class="fw-bold mb-1">Post a Job</h2>
                        <p class="mb-0 opacity-75">Fill in the details to find your next talent</p>
                    </div>

                    <div class="form-section">
                        <form asp-action="Create" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                            <div class="mb-4">
                                <label asp-for="JobTitle" class="form-label">
                                    <i class="fas fa-heading text-cadetblue"></i> Job Title
                                </label>
                                <input asp-for="JobTitle" class="form-control" placeholder="e.g. Senior Backend Developer" required />
                                <span asp-validation-for="JobTitle" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Requirements" class="form-label">
                                    <i class="fas fa-list-check text-cadetblue"></i> Requirements & Description
                                </label>
                                <textarea asp-for="Requirements" class="form-control" rows="6"
                                          placeholder="Enter the skills, experience, and responsibilities..." required></textarea>
                                <span asp-validation-for="Requirements" class="text-danger small"></span>
                                <div class="helper-text">Pro tip: Use bullet points for better readability.</div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label">
                                    <i class="fas fa-image text-cadetblue"></i> Job Banner Image
                                </label>
                                <div class="file-upload-wrapper" onclick="document.getElementById('imageFile').click()">
                                    <div class="upload-icon">
                                        <i class="fas fa-cloud-upload-alt"></i>
                                    </div>
                                    <div class="fw-bold">Click to upload or drag and drop</div>
                                    <div class="text-muted small">PNG, JPG or JPEG (Max. 2MB)</div>
                                    <input type="file" name="imageFile" id="imageFile" class="d-none"
                                           accept=".jpg,.jpeg,.png" required onchange="previewImage(this)" />

                                    <div class="preview-img-container" id="previewContainer">
                                        <img id="previewImage" src="#" alt="Preview" />
                                    </div>
                                </div>
                                <span class="text-danger small" asp-validation-for="ImagePath"></span>
                            </div>

                            <div class="mt-5">
                                <button type="submit" class="btn-submit">
                                    <i class="fas fa-paper-plane me-2"></i> Publish Job Posting
                                </button>
                                <a asp-action="MyPostedJobs" class="btn-back-link">
                                    <i class="fas fa-arrow-left me-1"></i> Back to My Jobs
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function previewImage(input) {
            const container = document.getElementById('previewContainer');
            const preview = document.getElementById('previewImage');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    container.style.display = 'block';
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}