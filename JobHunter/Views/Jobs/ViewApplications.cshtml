@using JobHunter.ViewModels
@model List<CvScoreItem>

@{
    ViewData["Title"] = "Job Applications - CVs";
}

<style>
    body {
        background-color: #f0f2f5;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        transition: transform .3s, box-shadow .3s;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 12px rgba(0,0,0,0.15);
        }

    .text-cadetblue {
        color: cadetblue !important;
    }

    .bg-cadetblue {
        background-color: cadetblue !important;
    }

    .btn-cadetblue {
        background-color: cadetblue;
        border-color: cadetblue;
        color: #fff;
        transition: all .3s;
    }

        .btn-cadetblue:hover {
            background-color: darkcyan;
            border-color: darkcyan;
        }

    .btn-outline-cadetblue {
        color: cadetblue;
        border-color: cadetblue;
        transition: all .3s;
    }

        .btn-outline-cadetblue:hover {
            background-color: cadetblue;
            color: #fff;
        }

    .btn-outline-secondary {
        color: #6c757d;
        border-color: #6c757d;
        transition: all .3s;
    }

        .btn-outline-secondary:hover {
            background-color: #6c757d;
            color: #fff;
        }

    .btn-action-group .btn {
        border-radius: 50px;
        margin: 0 5px;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(95,158,160,.1);
    }

    .table th, .table td {
        vertical-align: middle;
    }

    .status-badge {
        font-size: .8rem;
        padding: .5em .8em;
        border-radius: 50px;
    }

    #cvPreviewModal .modal-content {
        border-radius: 12px;
    }

    #cvPreviewFrame {
        height: 70vh;
        border-radius: 0 0 12px 12px;
    }

    .score-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        font-size: .78rem;
        font-weight: 700;
        color: #fff;
        box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    }

    .score-high {
        background: linear-gradient(135deg, #27ae60, #2ecc71);
    }

    .score-medium {
        background: linear-gradient(135deg, #e67e22, #f39c12);
    }

    .score-low {
        background: linear-gradient(135deg, #c0392b, #e74c3c);
    }

    .score-none {
        background: #adb5bd;
    }

    .score-bar {
        height: 5px;
        border-radius: 3px;
        background: #e9ecef;
        margin-top: 5px;
        width: 60px;
    }

    .score-bar-fill {
        height: 100%;
        border-radius: 3px;
        transition: width .6s;
    }
</style>

<div class="container py-5">
 
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="display-6 fw-bold text-cadetblue mb-1">
                <i class="fas fa-file-alt me-2"></i>Job Applications
            </h1>
            <p class="text-muted fs-6 mb-0">@ViewBag.JobTitle — Review and manage submitted resumes.</p>
        </div>
        <div>
            <a asp-action="MyPostedJobs" class="btn btn-outline-secondary btn-lg rounded-pill">
                <i class="fas fa-arrow-left me-2"></i>Back to My Jobs
            </a>
        </div>
    </div>

 
    <div class="row g-4 mb-5">
        <div class="col-12">
            <div class="card bg-cadetblue text-white">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase opacity-75 mb-1">Total Applications</h6>
                        <h2 class="mb-0 fw-bold">@Model.Count</h2>
                    </div>
                    <i class="fas fa-users fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

 
    <div class="card shadow-lg">
        <div class="card-header bg-white py-4 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-semibold">
                <i class="fas fa-list me-2 text-cadetblue"></i>Submitted Resumes
            </h5>
            <div class="btn-group btn-group-sm btn-action-group" role="group">
                <button class="btn btn-outline-cadetblue" onclick="downloadAllCVs()">
                    <i class="fas fa-download me-1"></i> Download All
                </button>
                <button class="btn btn-outline-secondary" onclick="toggleView()">
                    <i class="fas fa-th-large me-1"></i> Toggle View
                </button>
            </div>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-5x text-muted mb-4"></i>
                    <h4 class="text-muted fw-bold">No Applications Yet</h4>
                    <p class="text-muted">No one has applied for this job position yet.</p>
                </div>
            }
            else
            {
             
                <div id="tableView">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">#</th>
                                    <th>Applicant</th>
                                    <th>Resume</th>
                                    <th class="text-center">Match Score</th>                         
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int counter = 1;
                                }
                                @foreach (var item in Model)
                                {
                                    <tr class="@(string.IsNullOrEmpty(item.ResumeFilePath) ? "table-warning" : "")">

                                        <td class="ps-4 fw-semibold">@counter</td>

                                        
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle bg-cadetblue text-white d-flex align-items-center justify-content-center"
                                                     style="width:34px;height:34px;font-size:.8rem;font-weight:700;flex-shrink:0">
                                                    @(item.ApplicantName.FirstOrDefault())
                                                </div>
                                                <span class="fw-medium">@item.ApplicantName</span>
                                            </div>
                                        </td>

                                      
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.ResumeFilePath))
                                            {
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-file-pdf text-danger me-2"></i>
                                                    <div>
                                                        <div class="fw-medium">Resume #@counter</div>
                                                        <small class="text-muted">PDF Document</small>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-times-circle text-warning me-2"></i>
                                                    <span class="text-muted">No CV uploaded</span>
                                                </div>
                                            }
                                        </td>

                                        @{
                                    }
                                    
                                <td class="text-center">
                                    <div class="d-flex flex-column align-items-center">
                                        <div class="score-badge @(item.Score >= 70 ? "score-high" : item.Score >= 40 ? "score-medium" : item.Score > 0 ? "score-low" : "score-none")">
                                            @(item.Score > 0 ? $"{item.Score}%" : item.Score == -1 ? "Err" : "N/A")
                                        </div>
                                        @if (item.Score > 0)
                                                {
                                                    <div class="score-bar">
                                                        <div class="score-bar-fill"
                                                             style="width:@(item.Score)%;background:@(item.Score >= 70 ? "#27ae60" : item.Score >= 40 ? "#f39c12" : "#e74c3c")">
                                                        </div>
                                                    </div>
                                                }
                                        </div>
                                    </td>

                       
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(item.ResumeFilePath))
                                        {
                                            <div class="d-flex justify-content-center gap-2">
                                                <button class="btn btn-sm btn-outline-cadetblue rounded-pill"
                                                        onclick="previewCV('@item.ResumeFilePath', @counter)"
                                                        title="Quick Preview">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                                <a href="@Url.Content(item.ResumeFilePath)"
                                                   download="Resume_@(counter).pdf"
                                                   class="btn btn-sm btn-outline-cadetblue rounded-pill"
                                                   title="Download">
                                                    <i class="fas fa-download"></i>
                                                </a>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">No actions available</span>
                                        }
                                    </td>
                                </tr>
                                counter++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>

           
            <div id="gridView" class="d-none">
                <div class="row g-4 p-4">
                    @{
                        counter = 1;
                    }
                    @foreach (var item in Model.Where(r => !string.IsNullOrEmpty(r.ResumeFilePath)))
                    {
                        <div class="col-lg-3 col-md-4 col-sm-6">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body text-center d-flex flex-column justify-content-center">
                                    <div class="mb-2">
                                        <i class="fas fa-file-pdf fa-3x text-danger"></i>
                                    </div>
                                    <h6 class="fw-bold mb-0">@item.ApplicantName</h6>
                                    <small class="text-muted mb-2">Resume #@counter</small>
                                    <div class="score-badge @(item.Score >= 70 ? "score-high" : item.Score >= 40 ? "score-medium" : "score-low") mx-auto mb-2">
                                        @(item.Score > 0 ? $"{item.Score}%" : "N/A")
                                    </div>
                                    <div class="d-flex justify-content-center gap-2 mt-auto">
                                        <button class="btn btn-sm btn-cadetblue rounded-pill"
                                                onclick="previewCV('@item.ResumeFilePath', @counter)">
                                            <i class="fas fa-eye me-1"></i>Preview
                                        </button>
                                        <a href="@Url.Content(item.ResumeFilePath)"
                                           download="Resume_@(counter).pdf"
                                           class="btn btn-sm btn-cadetblue rounded-pill">
                                            <i class="fas fa-download me-1"></i>Download
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        counter++;
                    }
                </div>
            </div>
                        }
        </div>
    </div>
</div>

 
<div class="modal fade" id="cvPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cvPreviewTitle">Resume Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div id="loadingSpinner" class="text-center py-5">
                    <div class="spinner-border text-cadetblue" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Loading resume...</p>
                </div>
                <iframe id="cvPreviewFrame" src="" width="100%" frameborder="0" class="d-none"></iframe>
                <div id="previewError" class="alert alert-warning m-4 d-none">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Unable to preview this file. Please download it to view.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Close</button>
                <a id="downloadFromModal" href="" download class="btn btn-cadetblue rounded-pill">
                    <i class="fas fa-download me-2"></i>Download
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    const previewCV = (resumePath, number) => {
        const modal   = new bootstrap.Modal(document.getElementById('cvPreviewModal'));
        const frame   = document.getElementById('cvPreviewFrame');
        const spinner = document.getElementById('loadingSpinner');
        const error   = document.getElementById('previewError');

        document.getElementById('cvPreviewTitle').textContent     = `Resume #${number} Preview`;
        document.getElementById('downloadFromModal').href         = resumePath;
        document.getElementById('downloadFromModal').download     = `Resume_${number}.pdf`;

        spinner.classList.remove('d-none');
        frame.classList.add('d-none');
        error.classList.add('d-none');
        frame.src = '';
        modal.show();

        frame.src     = resumePath;
        frame.onload  = () => { spinner.classList.add('d-none'); frame.classList.remove('d-none'); };
        frame.onerror = () => { spinner.classList.add('d-none'); error.classList.remove('d-none'); };
    };

    const downloadAllCVs = () => {
        const links = document.querySelectorAll('#tableView a[download], #gridView a[download]');
        if (!links.length) { showCustomModal("Download Resumes", "No resumes available for download."); return; }
        showCustomModal("Confirm Download", `Download all ${links.length} resumes?`, () => {
            links.forEach((l, i) => setTimeout(() => l.click(), i * 500));
        });
    };

    const toggleView = () => {
        document.getElementById('tableView').classList.toggle('d-none');
        document.getElementById('gridView').classList.toggle('d-none');
    };

    function showCustomModal(title, message, onConfirm = null) {
        const html = `
            <div class="modal fade" id="customAlertModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">${title}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body"><p>${message}</p></div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Close</button>
                            ${onConfirm ? '<button type="button" class="btn btn-cadetblue rounded-pill" id="confirmBtn">Confirm</button>' : ''}
                        </div>
                    </div>
                </div>
            </div>`;
        document.body.insertAdjacentHTML('beforeend', html);
        const el    = document.getElementById('customAlertModal');
        const modal = new bootstrap.Modal(el);
        modal.show();
        if (onConfirm)
            document.getElementById('confirmBtn').addEventListener('click', () => { onConfirm(); modal.hide(); });
        el.addEventListener('hidden.bs.modal', () => el.remove());
    }

    document.getElementById('cvPreviewModal').addEventListener('hidden.bs.modal', () => {
        document.getElementById('cvPreviewFrame').src = '';
    });
</script>
