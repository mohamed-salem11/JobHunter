@model JobHunter.Models.Job

@{
    ViewData["Title"] = "Delete Job";
}

<style>
    .delete-page-container {
        background-color: #f8f9fa;
        padding: 50px 0;
        min-height: 80vh;
    }

    .delete-card {
        background: white;
        border: none;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        overflow: hidden;
        border-top: 5px solid #dc3545; 
    }

    .card-header-warning {
        background-color: #fff5f5;
        padding: 30px;
        text-align: center;
        border-bottom: 1px solid #fee2e2;
    }

    .warning-icon {
        font-size: 3rem;
        color: #dc3545;
        margin-bottom: 15px;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.1);
        }

        100% {
            transform: scale(1);
        }
    }

    .job-preview-section {
        padding: 30px;
    }

    .delete-image {
        width: 100%;
        height: 200px;
        object-fit: cover;
        border-radius: 15px;
        margin-bottom: 20px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    }

    .info-label {
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 1px;
    }

    .info-value {
        color: #1e293b;
        font-size: 1.1rem;
        margin-bottom: 20px;
        white-space: pre-line;  
    }

    .action-area {
        background-color: #f8fafc;
        padding: 25px 35px;
        display: flex;
        gap: 15px;
    }

    .btn-delete-confirm {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 12px;
        font-weight: 700;
        flex: 2;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

        .btn-delete-confirm:hover {
            background-color: #b91c1c;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.3);
        }

    .btn-cancel-back {
        background-color: #e2e8f0;
        color: #475569;
        text-decoration: none;
        padding: 12px 30px;
        border-radius: 12px;
        font-weight: 700;
        flex: 1;
        text-align: center;
        transition: all 0.3s ease;
    }

        .btn-cancel-back:hover {
            background-color: #cbd5e1;
            color: #1e293b;
        }
</style>

<div class="delete-page-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="delete-card">
                    <div class="card-header-warning">
                        <div class="warning-icon">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <h2 class="text-danger fw-bold">Delete Posting?</h2>
                        <p class="text-muted mb-0">This action is permanent and cannot be undone.</p>
                    </div>

                    <div class="job-preview-section">
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <img src="@Model.ImagePath" alt="Job Preview" class="delete-image" />
                        }

                        <div class="mb-3">
                            <div class="info-label">Job Title</div>
                            <div class="info-value fw-bold">@Model.JobTitle</div>
                        </div>

                        <div class="mb-3">
                            <div class="info-label">Requirements</div>
                            <div class="info-value" style="font-size: 0.95rem; color: #4b5563;">
                                @Model.Requirements
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="action-area">
                            <button type="submit" class="btn-delete-confirm">
                                <i class="fas fa-trash-alt"></i> Confirm Delete
                            </button>
                            <a asp-action="MyPostedJobs" class="btn-cancel-back">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>