@{
    ViewData["Title"] = "Setup Complete";
    var brandColor = "cadetblue";
}

<style>
    body {
        background-color: #f8fafb;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .success-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .success-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.05);
        padding: 50px 40px;
        width: 100%;
        max-width: 500px;
        text-align: center;
        border-bottom: 6px solid @brandColor;
    }

    .icon-circle {
        width: 80px;
        height: 80px;
        background-color: rgba(95, 158, 160, 0.1);
        color: @brandColor;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
        margin: 0 auto 25px;
    }

    .success-card h2 {
        color: #2d3436;
        font-weight: 800;
        font-size: 1.8rem;
        margin-bottom: 15px;
    }

    .success-card p {
        color: #636e72;
        font-size: 1.05rem;
        line-height: 1.6;
        margin-bottom: 35px;
    }

    .btn-explore {
        background-color: @brandColor;
        color: white;
        border: none;
        padding: 16px 30px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 1.1rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .btn-explore:hover {
            background-color: #4d8082;
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(95, 158, 160, 0.3);
        }

        .btn-explore:active {
            transform: translateY(0);
        }

    
    .checkmark-anim {
        animation: scaleIn 0.5s ease-out;
    }

    @Html.Raw("@") keyframes scaleIn {
        0%

    {
        transform: scale(0);
        opacity: 0;
    }

    100% {
        transform: scale(1);
        opacity: 1;
    }

    }
</style>

<div class="success-wrapper">
    <div class="success-card">
        <div class="icon-circle">
            <i class="bi bi-check-lg checkmark-anim"></i>
        </div>

        <h2>Great Choice!</h2>

        <p>
            @if (TempData["SuccessMessage"] != null)
            {
                @TempData["SuccessMessage"]
            }
            else
            {
                <span>Your career interests have been successfully saved. We are now ready to show you the best opportunities.</span>
            }
        </p>

        <a asp-controller="Jobs" asp-action="AllJobs" class="btn-explore">
            <span>Explore Recommended Jobs</span>
            <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</div>