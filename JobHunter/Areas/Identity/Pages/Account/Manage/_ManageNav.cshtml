@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
<style>
    .nav-pills {
        background-color: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
    }

        .nav-pills .nav-item {
            margin-bottom: 8px;
        }

        .nav-pills .nav-link {
            font-weight: 500;
            color: #333;
            border-radius: 6px;
            transition: background-color 0.2s ease, color 0.2s ease;
        }

            .nav-pills .nav-link:hover {
                background-color: #e0f0f0;
                color: cadetblue;
            }

            .nav-pills .nav-link.active {
                background-color: cadetblue !important;
                color: white !important;
            }

    .nav-icon {
        margin-right: 8px;
    }
</style>

<ul class="nav nav-pills flex-column">
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index">
            <i class="nav-icon bi bi-person-circle"></i> Profile
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" id="interests" asp-controller="Profile" asp-action="EditInterests">
            <i class="nav-icon bi bi-star"></i> Edit Interests
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.EmailNavClass(ViewContext)" id="email" asp-page="./Email">
            <i class="nav-icon bi bi-envelope"></i> Email
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword">
            <i class="nav-icon bi bi-lock"></i> Password
        </a>
    </li>
    @if (hasExternalLogins)
    {
        <li id="external-logins" class="nav-item">
            <a id="external-login" class="nav-link @ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="./ExternalLogins">
                <i class="nav-icon bi bi-box-arrow-in-right"></i> External logins
            </a>
        </li>
    }
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" id="two-factor" asp-page="./TwoFactorAuthentication">
            <i class="nav-icon bi bi-shield-lock"></i> Two-factor authentication
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.PersonalDataNavClass(ViewContext)" id="personal-data" asp-page="./PersonalData">
            <i class="nav-icon bi bi-file-earmark-person"></i> Personal data
        </a>
    </li>
</ul>
